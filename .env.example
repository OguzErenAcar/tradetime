# docker-compose.yml için. Kopyalayıp .env yap, değerleri doldur.

# backend/.env.example ile aynı VAPID public key + iletişim maili
VAPID_PUBLIC_KEY=
VAPID_CONTACT_EMAIL=

# Postgres şifresi — prod'da mutlaka değiştir (varsayılan sadece local dev için)
POSTGRES_PASSWORD=alarm_dev_pw

# Frontend'in tarayıcıdan erişeceği backend adresi (build-time, Vite bundle'a gömülür)
VITE_API_BASE_URL=http://localhost:8001

# Backend'in izin vereceği ek CORS origin'i (frontend'in tarayıcıdan görünen adresi)
ALLOWED_ORIGINS=http://localhost:8080

# Host portları (aynı makinede başka bir şeyle çakışırsa değiştir)
BACKEND_PORT=8001
FRONTEND_PORT=8080

# --- Sadece VPS/prod (`docker compose --profile prod up -d`) için ---
# Caddy'nin otomatik HTTPS alacağı adres. Prod'da yukarıdaki
# VITE_API_BASE_URL=/api ve ALLOWED_ORIGINS=https://<SITE_ADDRESS> olmalı
# (Caddy aynı origin'den servis ettiği için CORS bile gerekmiyor).
# SITE_ADDRESS=91-232-103-192.sslip.io
